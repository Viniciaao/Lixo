   "content_json_string": "{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"hardBreak\"}],\"attrs\":{\"level\":3}},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"Here is my part! Check out \"},{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"her!\"},{\"type\":\"text\",\"text\":\"(link coming soon)\"}],\"attrs\":{\"level\":3}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"EYES PRESETS 5f:\"},{\"type\":\"text\",\"text\":\" 3 presets, child+, females only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"LIPS PRESETS 7f:\"},{\"type\":\"text\",\"text\":\" 7 presets, child+, females only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"NOSE PRESETS 9f:\"},{\"type\":\"text\",\"text\":\" 6 presets, child+, females only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"EYEBROWS 48-51:\"},{\"type\":\"text\",\"text\":\" 27 swatches, \u00a0female only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"LIPS N43: \"},{\"type\":\"text\",\"text\":\"74 swatches (each color has 2 styles) teen+, female only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"LIPS N44: \"},{\"type\":\"text\",\"text\":\"50 swatches, female only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"LIPS N45: \"},{\"type\":\"text\",\"text\":\"44 swatches,  female only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"LIPS N46: \"},{\"type\":\"text\",\"text\":\"36 swatches,  female only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"NOSE BLUSH:\"},{\"type\":\"text\",\"text\":\" 13 swatches, 2 styles, child+, females only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"EYELINERS N13-15:\"},{\"type\":\"text\",\"text\":\" 18 swatches (each color has 2 styles)  female only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"EYELINER N16:\"},{\"type\":\"text\",\"text\":\" 9 swatches, female only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"EYESHADOWS N10:\"},{\"type\":\"text\",\"text\":\"\u00a030 swatches (each color has 2 styles), females only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"EYESHADOWS N11:\"},{\"type\":\"text\",\"text\":\" 35 swatches, females only\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"EYESHADOWS N12:\"},{\"type\":\"text\",\"text\":\" 52 swatches,  females only (better use with non overlay skins)\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"everything is HQ compatible, works with makeup sliders, previews were done with HQ mod\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"http://simfileshare.net/folder/151649/\",\"target\":\"_blank\"}},{\"type\":\"bold\"}],\"text\":\"DL\"},{\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}],\"text\":\"\u00a0\"}],\"attrs\":{\"level\":3}},{\"type\":\"heading\",\"content\":[{\"type\":\"hardBreak\"}],\"attrs\":{\"level\":3}},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"And now I want to die, it was too huge set for me. I did it literally EVERY day of the last month, but I already have plans for the new year set \ud83e\udd2a \u00a0\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"It also will be collaboration! We chose cc ideas together and it should be really awesome, stay in touch! \ud83d\ude0f\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"hardBreak\"}],\"attrs\":{\"level\":3}}]}",
